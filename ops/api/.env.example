# Ops API Configuration

PORT=8100
DATABASE_URL=sqlite:///./data/resolvix.db
SERVICE_KEY=change-me-in-production-service-key-for-runtime
SESSION_SECRET=change-me-in-production-session-secret-32plus-chars
SEED_PASSWORD=DemoPassword123!
OPS_PUBLIC_URL=http://localhost:8100
CORS_ORIGINS=http://localhost:5173

# Runtime integration
RUNTIME_MODE=mock                     # mock | live (real is accepted): live makes KB publish call RUNTIME_URL
RUNTIME_URL=http://localhost:8000

# Notifications
NOTIFY_MODE=mock                      # mock | twilio (live is an alias)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                          # sender number or DLT-registered sender id

# Config files (relative to ops/api directory)
DEPARTMENTS_FILE=../../contracts/config/departments.yaml
URGENCY_RULES_FILE=../../contracts/config/urgency_rules.yaml
SMS_TEMPLATES_FILE=../../contracts/config/sms_templates.yaml

# Timezone
TIMEZONE=Asia/Kolkata

# Seed users on startup
SEED_USERS_ON_STARTUP=true

# SMS tuning (defaults shown)
# NOTIFY_ASYNC=                       # empty: async for twilio, synchronous for mock; true|false forces it
SMS_SEND_TIMEOUT_S=5
SMS_POLL_ENABLED=true                 # one status poll 10 s after a send when OPS_PUBLIC_URL is localhost
SMS_POLL_DELAY_S=10

# Login brute-force guard: attempts per minute per client IP (0 disables)
LOGIN_RATE_LIMIT_PER_MIN=10

# Knowledge base
KB_IMPORT_MAX_BYTES=2097152
KB_IMPORT_MAX_LINES=2000
KB_PUBLISH_TIMEOUT_S=30

# Gap clustering: keywords (embedding needs a cloud embedding key and is not available yet)
GAP_CLUSTER_STRATEGY=keywords

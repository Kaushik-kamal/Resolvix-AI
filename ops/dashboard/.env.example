# Base URL of the ops-api. Leave EMPTY in development: the Vite dev server proxies /v1 and /healthz to
# VITE_PROXY_TARGET, which keeps the session cookie same-origin. Set it (e.g. http://localhost:8100) only when the
# dashboard is served from another origin; the API then needs CORS_ORIGINS to include the dashboard origin.
VITE_OPS_API_URL=
# Where the Vite dev/preview proxy forwards /v1 and /healthz (read by vite.config.ts, not exposed to the browser).
VITE_PROXY_TARGET=http://localhost:8100
# Voice runtime (Member A): used for links to the web-call and typed-test pages.
VITE_RUNTIME_URL=http://localhost:8000
